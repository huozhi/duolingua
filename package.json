{
  "name": "duolingua",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "app": "native dev native-shell -Dtrace=off",
    "desktop:pack": "sh scripts/package-desktop.sh",
    "native:check": "native check native-shell",
    "native:build": "native build native-shell",
    "test": "node --test \"src/**/*.test.ts\"",
    "dict:fetch": "node scripts/fetch-sources.ts",
    "dict:build": "node --max-old-space-size=8192 scripts/build-dict.ts",
    "dict:lookup": "node scripts/lookup.ts",
    "models:fetch": "node scripts/fetch-models.ts",
    "models:size": "node scripts/report-model-sizes.ts",
    "translate": "node scripts/translate.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "next": "16.3.0-canary.96",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@native-sdk/cli": "^0.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-node": "1.23.2"
    }
  }
}
