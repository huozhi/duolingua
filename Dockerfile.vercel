# Vercel container deployment for q4.
#
# Vercel detects this exact filename, builds it as an OCI image, and routes the
# deployment to the HTTP server started by CMD. The image contains the compiled
# dictionary, all seven translation models, and native ONNX Runtime, so requests
# never depend on downloading model files at runtime.
#
# Debian rather than Alpine: onnxruntime-node's native binding links against
# glibc.

# ── deps ──────────────────────────────────────────────────────────────────────
FROM node:24-slim AS deps
WORKDIR /app

RUN npm install --global pnpm@10

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# ── build ─────────────────────────────────────────────────────────────────────
FROM deps AS build
WORKDIR /app

COPY . .
RUN pnpm build

# ── models ────────────────────────────────────────────────────────────────────
FROM deps AS models
WORKDIR /app

COPY package.json ./
COPY scripts ./scripts
COPY src ./src
ENV MODEL_CACHE_DIR=/models
RUN node scripts/fetch-models.ts

# ── runtime ───────────────────────────────────────────────────────────────────
FROM node:24-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    MODEL_CACHE_DIR=/models \
    HOSTNAME=0.0.0.0

COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/data/dict ./data/dict
COPY --from=models --chown=node:node /models /models

USER node

# Vercel supplies PORT (default 80). Next's standalone server reads it directly.
EXPOSE 80

CMD ["node", "server.js"]
